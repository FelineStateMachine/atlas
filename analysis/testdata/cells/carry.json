          -2708.7329376470884
        ]
      ],
      "expect": true,
      "handDerived": true
    },
    {
      "name": "geohash-m-to-s2",
      "ground": "test/sphere-8192x4096",
      "call": "equivalentCell",
      "args": [
        "geohash",
        "s2",
        "m"
      ],
      "expect": "24"
