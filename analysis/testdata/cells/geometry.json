{
  "family": "geometry",
  "about": "The shapes: bbox in OL world coordinates (x east, y negative-down), the centre, and the closed ring. Every geohash number here is the recursive halving of the surface, five bits to a character, alternating axes — the arithmetic the app has always done.",
  "cases": [
    {
      "name": "geohash-bbox-root",
      "ground": "test/square-1024",
      "system": "geohash",
      "call": "bbox",
      "args": [
        ""
      ],
      "expect": [
        0,
        -1024,
        1024,
        0
      ],
      "handDerived": true
    },
    {
      "name": "geohash-bbox-m",
      "ground": "test/square-1024",
      "system": "geohash",
      "call": "bbox",
      "args": [
        "m"
      ],
      "expect": [
        640,
        -768,
        768,
        -512
      ],
      "note": "m = alphabet index 19 = 10011: x right, y bottom, x left, y up, x right.",
      "handDerived": true
    },
    {
      "name": "geohash-bbox-m6",
      "ground": "test/square-1024",
      "system": "geohash",
      "call": "bbox",
