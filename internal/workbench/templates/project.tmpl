{{define "title"}}Project{{end}}
{{define "content"}}
<section class="page-head">
  <p class="eyebrow">One manifest → one native volume</p>
  <h1>{{if .Project.Title}}{{.Project.Title}}{{else}}Atlas project{{end}}</h1>
  <p class="dim"><b>{{.Targets.Project}}</b></p>
  {{if .Notice}}<p class="notice">{{.Notice}}</p>{{end}}
  {{if .Error}}<p class="warn">{{.Error}}</p>{{end}}
</section>

<section class="card area-authoring" aria-labelledby="area-authoring-title">
  <header class="authoring-head">
    <div>
      <p class="eyebrow">Nationwide source profile</p>
      <h2 id="area-authoring-title">Choose a U.S. area</h2>
      <p class="dim">One bounded region becomes the single manifest below. The label stays neutral: Sample Region.</p>
    </div>
    <ol class="authoring-flow" aria-label="Authoring flow">
      <li class="active">Area</li><li>Sources</li><li>Contracts</li><li>Build</li><li>Compiled preview</li>
    </ol>
  </header>

  <form class="area-form" method="post" action="/project/us-area" data-us-area-form>
    <fieldset class="area-bounds">
      <legend>Area · WGS84 bbox</legend>
      <div class="area-map-toolbar">
        <label>Region
          <select data-map-region>
            <option value="conus">Lower 48</option><option value="alaska">Alaska</option><option value="hawaii">Hawaii</option><option value="puerto-rico">Puerto Rico</option>
          </select>
        </label>
        <span>Drag to draw · aligned source window is outlined</span>
      </div>
      <canvas class="area-map" width="720" height="300" tabindex="0" aria-label="Drag to select a rectangular map area" data-area-map></canvas>
      <label>West<input type="number" name="west" value="-105.1" min="-180" max="180" step="0.000001" required></label>
      <label>South<input type="number" name="south" value="39.6" min="-90" max="90" step="0.000001" required></label>
      <label>East<input type="number" name="east" value="-104.9" min="-180" max="180" step="0.000001" required></label>
      <label>North<input type="number" name="north" value="39.8" min="-90" max="90" step="0.000001" required></label>
      <label class="detail-control">Detail zoom <output data-detail-output>12</output>
        <input type="range" name="detail" value="12" min="6" max="16" step="1">
      </label>
    </fieldset>

    <fieldset class="source-picker">
      <legend>Official nationwide sources</legend>
      <label class="source-choice topo"><input type="checkbox" name="topo" value="true" checked><span><b>USGS Topo</b><small>raster · public domain</small></span></label>
      <label class="source-choice roads"><input type="checkbox" name="roads" value="true" checked><span><b>TIGER roads</b><small>paths · typed class</small></span></label>
      <label class="source-choice hydro"><input type="checkbox" name="hydro" value="true" checked><span><b>TIGER hydro</b><small>paths + areas</small></span></label>
      <label class="source-choice counties"><input type="checkbox" name="counties" value="true" checked><span><b>TIGER counties</b><small>areas · context</small></span></label>
    </fieldset>

    <aside class="budget-preview" aria-live="polite" data-budget-preview>
      <span class="node-kind">Selection budget</span>
      <b><output data-budget-tiles>estimating</output> raster tiles</b>
      <span><output data-budget-size>—</output> local pixel plane</span>
      <span><output data-budget-state>Adjust the box or detail to preview.</output></span>
    </aside>

    <fieldset class="presentation-editor">
      <legend>Presentation · compiled into layers, styles + legend</legend>
      <div class="presentation-head"><span>Layer</span><span>Legend label</span><span>Style</span><span>Order</span></div>
      <label class="presentation-row">
        <span><input type="checkbox" name="road-visible" value="true" checked> Roads visible</span>
        <input type="text" name="road-label" value="Roads" maxlength="48" required aria-label="Road legend label">
        <input type="color" name="road-color" value="#b45f3c" aria-label="Road color">
        <input type="number" name="road-order" value="40" min="0" max="999" required aria-label="Road layer order">
      </label>
      <label class="presentation-row">
        <span><input type="checkbox" name="hydro-visible" value="true" checked> Water visible</span>
        <input type="text" name="hydro-label" value="Water" maxlength="48" required aria-label="Water legend label">
        <span class="color-pair"><input type="color" name="hydro-color" value="#4b8db8" aria-label="Water line color"><input type="color" name="hydro-fill" value="#b9d9ea" aria-label="Water fill color"></span>
        <input type="number" name="hydro-order" value="20" min="0" max="999" required aria-label="Water layer order">
      </label>
      <label class="presentation-row">
        <span><input type="checkbox" name="county-visible" value="true" checked> Counties visible</span>
        <input type="text" name="county-label" value="Counties" maxlength="48" required aria-label="County legend label">
        <input type="color" name="county-color" value="#766b5b" aria-label="County color">
        <input type="number" name="county-order" value="10" min="0" max="999" required aria-label="County layer order">
      </label>
    </fieldset>
    <button class="generate-manifest">Generate single manifest</button>
  </form>

  <div class="contract-preview">
    <div>
      <span class="node-kind">Typed FeatureSets</span>
      <p><span class="contract-pill path">roads · path</span><span class="contract-pill path">waterways · path</span><span class="contract-pill area">water bodies · area</span><span class="contract-pill area">counties · area</span></p>
      <p class="dim">Stable identities, typed properties, EPSG:3857 → local affine geometry, provenance on every source.</p>
    </div>
    <i class="graph-arrow" aria-hidden="true">→</i>
    <div>
      <span class="node-kind">Presentation</span>
      <p class="style-stack"><i class="swatch county"></i><i class="swatch water"></i><i class="swatch road"></i> counties · water · roads over topo</p>
      <p class="dim">Layers, styles, labels and legend compile into the artifact.</p>
    </div>
    <i class="graph-arrow" aria-hidden="true">→</i>
    <div class="truth-preview">
      <span class="node-kind">Compiled Atlas truth</span>
      <b>{{if and .Run.Artifact (not .Run.Failed)}}Ready to inspect{{else}}Available after build{{end}}</b>
      <span class="dim">Preview never substitutes browser-side source data.</span>
      {{if and .Run.Artifact (not .Run.Failed)}}<a href="/project/inspect">Inspect compiled artifact</a>{{end}}
    </div>
  </div>
</section>

{{if .Project.ID}}
<section class="card contract-graph" aria-labelledby="contract-graph-title">
  <header class="graph-head">
    <div>
      <p class="eyebrow">Resolved authoring contract</p>
      <h2 id="contract-graph-title">Sources become semantic FeatureSets</h2>
    </div>
    <p class="graph-totals"><b>{{.SourceCount}}</b> feature sources · <b>{{.FeatureSets}}</b> semantic sets · <b>{{.RasterCount}}</b> raster pyramids · <b>{{.LayerCount}}</b> presentation layers</p>
  </header>

  <div class="contract-groups">
  {{range .Graph.FeatureSets}}
    <section class="contract-group" aria-labelledby="feature-set-{{.ID}}">
      <div class="source-lanes">
      {{range .Sources}}
        <div class="source-lane">
          <article class="graph-node source-node">
            <span class="node-kind">Source</span>
            <b>{{.ID}}</b>
            <span class="node-detail" title="{{.Locator}}">{{.Locator}}</span>
            <span class="status-chip {{if .Cached}}ready{{else}}fetch{{end}}">{{.Cache}}</span>
          </article>
          <i class="graph-arrow" aria-hidden="true">→</i>
          <article class="graph-node adapter-node">
            <span class="node-kind">Adapter</span>
            <b>{{.Adapter}}</b>
            <span class="node-detail">immutable evidence</span>
          </article>
          <i class="graph-arrow" aria-hidden="true">→</i>
          <article class="graph-node mapping-node">
            <span class="node-kind">Mapping</span>
            <b>{{.Geometry}} · {{.Transform}}</b>
            <span class="node-detail">{{.Identity}} → {{.FeatureTitle}}</span>
            <span class="node-detail">{{.SourceSpace}} → world</span>
            <span class="node-counts">{{.PropertyCount}} properties{{if .RelationCount}} · {{.RelationCount}} relationships{{end}}</span>
          </article>
        </div>
      {{end}}
      </div>
      <i class="graph-arrow merge-arrow" aria-hidden="true">→</i>
      <article class="graph-node contract-node">
        <span class="node-kind">FeatureSet contract</span>
        <h3 id="feature-set-{{.ID}}">{{.Title}}</h3>
        <code>{{.ID}}</code>
        <p><span class="status-chip semantic">{{.SemanticType}}</span><span class="status-chip geometry">{{.Geometry}}</span></p>
        <details class="contract-detail">
          <summary>{{len .Properties}} typed properties</summary>
          {{if .Properties}}<dl class="contract-list">
          {{range .Properties}}<div><dt>{{.Name}}</dt><dd><code>{{.Type}}</code>{{if .Optional}} <span class="dim">optional</span>{{end}}</dd></div>{{end}}
          </dl>{{else}}<p class="dim">No typed properties.</p>{{end}}
        </details>
        <details class="contract-detail">
          <summary>{{len .Relations}} relationships</summary>
          {{if .Relations}}<dl class="contract-list">
          {{range .Relations}}<div><dt>{{.Predicate}}</dt><dd>→ <code>{{.Target}}</code>{{if .Optional}} <span class="dim">optional</span>{{end}}</dd></div>{{end}}
          </dl>{{else}}<p class="dim">No relationships.</p>{{end}}
        </details>
      </article>
    </section>
  {{end}}
  </div>

  <div class="artifact-flow">
    <div class="side-inputs" aria-label="Other artifact inputs">
      {{range .Graph.Rasters}}<span class="side-input"><b>{{.ID}}</b> · {{.Adapter}} <i class="status-chip {{if .Cached}}ready{{else}}fetch{{end}}">{{.Cache}}</i></span>{{end}}
      {{range .Graph.Assets}}<span class="side-input"><b>{{.ID}}</b> · asset <i class="status-chip {{if .Cached}}ready{{else}}fetch{{end}}">{{.Cache}}</i></span>{{end}}
      <span class="side-input"><b>{{.Graph.Layers}}</b> layers · <b>{{.Graph.Styles}}</b> styles</span>
    </div>
    <i class="graph-arrow" aria-hidden="true">→</i>
    <div class="graph-node artifact-node">
      <span class="node-kind">Artifact</span>
      <b>.atlas</b>
      <span class="node-detail">native vNext · planned</span>
    </div>
  </div>
</section>

<div class="columns project-columns">
<section class="card">
  <h2>Resolved plan</h2>
  <p class="score">{{.CachedCount}} / {{.RequestCount}} requests cached</p>
  <dl class="terms">
    <div><dt>project digest</dt><dd><code>{{short .Plan.ProjectDigest}}</code></dd></div>
    <div><dt>world</dt><dd>{{.Plan.World}}</dd></div>
    <div><dt>estimated input</dt><dd>{{.Plan.Estimated}} bytes</dd></div>
    <div><dt>Capture requests</dt><dd>{{.RequestCount}}</dd></div>
    <div><dt>Raster tiles</dt><dd>{{.Plan.RasterTiles}}</dd></div>
    <div><dt>output library</dt><dd>{{.Plan.Output}}</dd></div>
  </dl>
  <details class="plan-detail">
    <summary>{{len .Plan.Requests}} evidence requests</summary>
    <table>
      <thead><tr><th>source</th><th>adapter</th><th>kind</th><th>cache</th></tr></thead>
      <tbody>{{range .Plan.Requests}}<tr><td>{{.Source}}</td><td>{{.Adapter}}</td><td>{{.Kind}}</td><td>{{if .Cached}}ready{{else}}fetch{{end}}</td></tr>{{end}}</tbody>
    </table>
  </details>
  <details class="plan-detail">
    <summary>{{len .Plan.Licenses}} provenance obligations</summary>
    {{range .Plan.Licenses}}<p><b>{{.Source}}</b>{{if .License}} · {{.License}}{{end}}{{if .Attribution}}<br><span class="dim">{{.Attribution}}</span>{{end}}</p>{{end}}
  </details>
</section>

<section class="card build-control">
  <h2>Build</h2>
  <p class="dim">Capture immutable evidence, observe, assemble semantics and presentation, compile, validate, then atomically install.</p>
  <form method="post" action="/project/build">
    <button>Build native Atlas</button>
    <label><input type="checkbox" name="offline" value="true"> offline / cached only</label>
  </form>
  {{template "project-run" .}}
</section>
</div>
{{end}}

<details class="card manifest-editor"{{if .Error}} open{{end}}>
  <summary><b>Portable manifest</b> <span class="dim">Edit the single configuration file</span></summary>
  <p class="dim">Captured evidence stays in the shared cache; completed volumes stay in the Atlas library.</p>
  <form method="post" action="/project/save">
    <textarea name="manifest" spellcheck="false" aria-label="Atlas project manifest">{{.Manifest}}</textarea>
    <button>Validate and save</button>
  </form>
</details>
{{end}}

{{define "project-run"}}
<div id="project-run"{{if .Run.Running}} hx-get="/project/run" hx-trigger="load, every 1s" hx-swap="outerHTML"{{end}}>
  <ol class="stage-rail" aria-label="Build stages">
    {{range .Stages}}<li class="{{.State}}" data-stage="{{.ID}}"><span aria-hidden="true"></span><b>{{.Label}}</b></li>{{end}}
  </ol>
  {{if .Run.Name}}
    <p class="run-state {{if .Run.Failed}}failed{{else if .Run.Running}}running{{else}}done{{end}}">
      {{if .Run.Running}}Building… safe to leave this page{{else if .Run.Failed}}Build failed{{else}}Build complete{{end}}
    </p>
    <details class="build-log"{{if .Run.Failed}} open{{end}}>
      <summary>Raw diagnostics <span class="dim">{{len .Run.Rows}} rows</span></summary>
      <div id="op-log" class="console" aria-live="polite">
        {{range .Run.Rows}}{{template "op-row" .}}{{end}}
      </div>
    </details>
  {{end}}
  {{if and .Run.Artifact (not .Run.Running) (not .Run.Failed)}}
  <div class="artifact-handoff" draggable="true" data-artifact-handoff
       data-artifact-name="{{.ArtifactName}}" data-artifact-path="{{.Run.Artifact}}">
    <div><span class="file-icon">A</span><b>{{.ArtifactName}}</b><br><span class="dim">Drag this file onto an Atlas window</span></div>
    <a href="/project/inspect">Inspect packed data</a>
    <form method="post" action="/project/open"><button>Open in Atlas</button></form>
  </div>
  {{end}}
</div>
{{end}}
