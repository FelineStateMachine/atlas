{{define "title"}}Cartograph · {{.Game.Title}}{{end}}
{{define "content"}}
<section class="page-head">
  <h1>{{.Game.Title}} <span class="dim">{{.Game.Slug}}</span></h1>
  <p class="dim">{{len .Game.Builds}} builds, newest first — the first is the one the reader serves.</p>
</section>
{{range $at, $b := .Game.Builds}}
<section class="build{{if eq $at 0}} serving{{end}}">
  <h2>{{$b.File}}{{if eq $at 0}} <span class="tag">serving</span>{{end}}</h2>
  <p class="dim">captured {{$b.CreatedAt}} · revision {{$b.Revision}} · stamp {{$b.ShortStamp}}</p>
  <dl class="axes">
    <div><dt>annotation</dt><dd><b>{{$b.Pins}}</b> pins · {{$b.Described}} described ({{$b.DescribedPct}}) · median {{$b.MedianLength}} chars</dd></div>
    <div><dt>cartography</dt><dd><b>{{$b.TileCount}}</b> tiles · {{$b.RasterMB}} MB unique raster · depth z{{$b.Depth}} holds {{$b.DepthTiles}} tiles</dd></div>
    <div><dt>structure</dt><dd><b>{{$b.Categories}}</b> categories in {{$b.Groups}} groups · {{$b.TextSets}} text label sets · {{$b.Zones}} zones ({{$b.Vertices}} vertices) · {{$b.Variants}} layers</dd></div>
    <div><dt>icons</dt><dd><b>{{$b.IconsCarried}}</b> of {{$b.IconsWanted}} marker categories carry one ({{$b.IconPct}})</dd></div>
  </dl>
  {{if $b.Merges}}
  <table class="merges">
    <thead><tr>
      <th>map</th><th>source</th><th class="num">donor pins</th><th class="num">matched</th>
      <th class="num">median px</th><th class="num">added</th><th class="num">adopted</th>
      <th class="num">held</th><th class="num">rejected</th><th>alignment</th>
    </tr></thead>
    <tbody>
    {{range $b.Merges}}
      <tr>
        <td>{{.Map}}</td><td>{{.Source}}</td>
        <td class="num">{{.DonorPins}}</td><td class="num">{{.MatchedN}}</td>
        <td class="num">{{.MedianMatchPx}}</td><td class="num">{{.Added}}</td>
        <td class="num">{{.AdoptedN}}</td><td class="num">{{.HeldN}}</td>
        <td class="num">{{.RejectedN}}</td><td class="dim">{{.Alignment}}</td>
      </tr>
    {{end}}
    </tbody>
  </table>
  {{range $b.Merges}}{{if .Held}}
  <details class="ledger">
    <summary>{{.Source}} · {{.Map}} — {{.HeldN}} pins held back</summary>
    <table>
      <thead><tr><th class="num">donor id</th><th>title</th><th>reason</th></tr></thead>
      <tbody>
      {{range .Held}}<tr><td class="num">{{.Donor}}</td><td>{{.Title}}</td><td class="dim">{{.Reason}}</td></tr>{{end}}
      </tbody>
    </table>
  </details>
  {{end}}{{end}}
  {{end}}
</section>
{{end}}
{{end}}
