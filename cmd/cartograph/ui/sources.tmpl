{{define "title"}}Cartograph · sources{{end}}
{{define "content"}}
<section class="page-head">
  <h1>Sources</h1>
  <p class="dim">Each source contributes components to a volume's bundle; composition merges them by title and slug, with provenance. Re-fetching unchanged data is a no-op.</p>
</section>

<div class="columns">
{{range .Sources}}
<section class="card">
  <h2>{{.Name}} <span class="dim">{{.Slug}}</span></h2>
  <p>{{range .Components}}<span class="badge">{{.}}</span>{{end}}</p>
  <p class="dim">{{.Description}}</p>
  <form data-op action="/ops/run" method="post">
    <input type="hidden" name="op" value="fetch">
    <input type="hidden" name="source" value="{{.Slug}}">
    <input name="target" placeholder="{{.TargetHint}}" required>
    <button>Fetch</button>
  </form>
</section>
{{end}}
</div>

<section class="card">
  <h2>Pipeline</h2>
  <p class="dim">
    repo <b>{{if .Repo}}{{.Repo}}{{else}}not found — start with -repo{{end}}</b> ·
    archive <b>{{if .Archive}}{{.Archive}}{{else}}not set — start with -archive{{end}}</b> ·
    bundles <b>{{.Bundles}}</b>
  </p>
  <form data-op action="/ops/run" method="post">
    <input type="hidden" name="op" value="tiles">
    <button>Rebuild pyramids</button>
    <span class="dim">tools/tiles derives every pyramid the archive holds into build/tiles, incrementally.</span>
  </form>
  <form data-op action="/ops/run" method="post">
    <input type="hidden" name="op" value="generate">
    <button>Recompose bundles</button>
    <span class="dim">tools/generate merges sources and installs versioned builds into the bundles directory.</span>
  </form>
</section>

<pre id="op-output" class="console"></pre>
{{end}}
